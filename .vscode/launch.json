{
    // Press F5 to run the selected configuration (pick one in the
    // Run and Debug view). Needs the CodeLLDB extension.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Edit CBM: sample file",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "-p", "edit-cbm", "--bin=edit-cbm"],
                "filter": { "name": "edit-cbm", "kind": "bin" }
            },
            "args": ["${workspaceFolder}/samples/SAMPLE.SEQ"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Edit CBM: choose a file",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "-p", "edit-cbm", "--bin=edit-cbm"],
                "filter": { "name": "edit-cbm", "kind": "bin" }
            },
            "args": ["${input:fileToEdit}"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug tests: cbm crate",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["test", "--no-run", "-p", "cbm", "--lib"],
                "filter": { "name": "cbm", "kind": "lib" }
            },
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "fileToEdit",
            "type": "promptString",
            "description": "File to open (a new file is created when you save)",
            "default": "${workspaceFolder}/samples/SAMPLE.SEQ"
        }
    ]
}
